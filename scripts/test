#!/usr/bin/env bash
# Ground-truth verification: lint, formatting, types, and tests.
# Run from anywhere; the repository root is resolved from this script's path.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if ! command -v uv >/dev/null 2>&1; then
    export PATH="$HOME/.local/bin:$PATH"
fi

uv run ruff check .
uv run ruff format --check .
uv run mypy
uv run pytest
