#!/usr/bin/env bash
# Auto-fixing developer checks: format, lint, types, and tests.
# Safe to run repeatedly; run before committing.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if ! command -v uv >/dev/null 2>&1; then
    export PATH="$HOME/.local/bin:$PATH"
fi

uv run ruff check --fix .
uv run ruff format .
uv run mypy
uv run pytest
